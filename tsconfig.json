{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "declaration": true,
    "declarationMap": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": false,
    "composite": false,
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "@superior-ai/core": ["packages/core/src/index.ts"],
      "@superior-ai/shared": ["packages/shared/src/index.ts"],
      "@superior-ai/agents": ["packages/agents/src/index.ts"],
      "@superior-ai/ai-gateway": ["packages/ai-gateway/src/index.ts"],
      "@superior-ai/auth": ["packages/auth/src/index.ts"],
      "@superior-ai/brand": ["packages/brand/src/index.ts"],
      "@superior-ai/intelligence": ["packages/intelligence/src/index.ts"],
      "@superior-ai/audit": ["packages/audit/src/index.ts"],
      "@superior-ai/billing": ["packages/billing/src/index.ts"],
      "@superior-ai/crm": ["packages/crm/src/index.ts"],
      "@superior-ai/db": ["packages/db/src/index.ts"],
      "@superior-ai/marketing": ["packages/marketing/src/index.ts"],
      "@superior-ai/memory": ["packages/memory/src/index.ts"],
      "@superior-ai/observability": ["packages/observability/src/index.ts"],
      "@superior-ai/queue": ["packages/queue/src/index.ts"],
      "@superior-ai/tools": ["packages/tools/src/index.ts"],
      "@superior-ai/creative": ["packages/creative/src/index.ts"],
      "@superior-ai/seo": ["packages/seo/src/index.ts"],
      "@superior-ai/social": ["packages/social/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "**/dist", "**/.next"]
}
