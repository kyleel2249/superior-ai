{
  "name": "superior-ai",
  "version": "0.1.0",
  "private": true,
  "description": "SUPERIOR AI \u2014 Multi-Model Autonomous Expert Agent Platform. One AI. An Entire Team Behind It.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --filter=@superior-ai/web",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "db:generate": "npm run generate --workspace=@superior-ai/db",
    "db:migrate": "npm run migrate --workspace=@superior-ai/db",
    "db:studio": "npm run studio --workspace=@superior-ai/db",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "smoke": "node scripts/smoke.mjs",
    "worker": "npx tsx packages/queue/src/worker.ts",
    "test:e2e": "playwright test",
    "dev:all": "turbo run dev",
    "dev:web": "npm run dev --workspace=@superior-ai/web",
    "build:web": "npm run build --workspace=@superior-ai/web",
    "start": "npm run start --workspace=@superior-ai/web",
    "db:push": "npm run push --workspace=@superior-ai/db",
    "postinstall": "node scripts/postinstall.mjs"
  },
  "overrides": {
    "ioredis": "^5.4.0"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "^5.8.0",
    "prettier": "^3.5.0",
    "@types/node": "^22.0.0",
    "@playwright/test": "^1.50.0"
  },
  "engines": {
    "node": ">=20",
    "npm": ">=10"
  },
  "packageManager": "npm@10.9.7",
  "optionalDependencies": {
    "jose": "^5.9.0",
    "ioredis": "^5.4.0"
  }
}
