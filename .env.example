# SUPERIOR AI — Environment Configuration
# Copy to .env and fill in values. Never commit real secrets.

NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
API_URL=http://localhost:4000
APP_NAME=SUPERIOR AI

DATABASE_URL=postgresql://superior:superior@localhost:5432/superior_ai?schema=public
REDIS_URL=redis://localhost:6379

NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-to-a-long-random-secret-in-production

S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=superior-ai-artifacts
S3_REGION=us-east-1

# SUPERIOR AI routes every model (OpenAI, Anthropic, Google, xAI, Meta,
# DeepSeek, etc.) through a single OpenRouter connection. This is the
# only provider key that's actually wired up right now.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_APP_TITLE=SUPERIOR AI
OPENROUTER_HTTP_REFERER=
ENABLE_MULTI_KEY_POOL=true
ENABLE_COST_TRACKING=true
DEFAULT_INTELLIGENCE_LEVEL=BALANCED

ENCRYPTION_KEY=change-me-32-byte-hex-or-base64-key-for-secrets
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

LOG_LEVEL=info
