# SUPERIOR AI — Environment Configuration
# Copy to .env and fill in values. Never commit real secrets.

NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
API_URL=http://localhost:4000
APP_NAME=SUPERIOR AI

DATABASE_URL=postgresql://superior:superior@localhost:5432/superior_ai?schema=public
REDIS_URL=redis://localhost:6379

NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-to-a-long-random-secret-in-production

S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=superior-ai-artifacts
S3_REGION=us-east-1

OPENAI_API_KEY=
OPENAI_ORG_ID=
OPENAI_BASE_URL=https://api.openai.com/v1

ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com

XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1

GOOGLE_AI_API_KEY=
GOOGLE_AI_BASE_URL=https://generativelanguage.googleapis.com

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_HTTP_REFERER=http://localhost:3000
OPENROUTER_APP_TITLE=SUPERIOR AI
# Optional: point OPENAI_* at OpenRouter for compatible clients
# OPENAI_API_KEY=  (same as OpenRouter key)
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_EMBEDDING_MODEL=openai/text-embedding-3-small

LOCAL_INFERENCE_URL=http://localhost:11434/v1
LOCAL_INFERENCE_API_KEY=

ENABLE_LOCAL_FALLBACK=true
ENABLE_MULTI_KEY_POOL=true
ENABLE_COST_TRACKING=true
DEFAULT_INTELLIGENCE_LEVEL=BALANCED

ENCRYPTION_KEY=change-me-32-byte-hex-or-base64-key-for-secrets
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

LOG_LEVEL=info


# Image generation
OPENAI_IMAGE_MODEL=gpt-image-1

# CRM (BYOK)
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_API_KEY=
SALESFORCE_ACCESS_TOKEN=
SALESFORCE_INSTANCE_URL=

# Worker
SUPERIOR_WORKER=0
WORKER_CONCURRENCY=2

# Social (official OAuth tokens only)
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=
X_ACCESS_TOKEN=
FACEBOOK_PAGE_ACCESS_TOKEN=
INSTAGRAM_ACCESS_TOKEN=
YOUTUBE_ACCESS_TOKEN=
TIKTOK_ACCESS_TOKEN=
PINTEREST_ACCESS_TOKEN=

# Embeddings
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Auth
AUTH_SECRET=generate-a-long-random-string
NEXTAUTH_SECRET=
AUTH_OIDC_ISSUER=
AUTH_OIDC_CLIENT_ID=
AUTH_OIDC_CLIENT_SECRET=
AUTH_OIDC_REDIRECT_URI=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_METER_PRICE_ID=

# Instagram (Meta)
INSTAGRAM_BUSINESS_ACCOUNT_ID=
FACEBOOK_PAGE_ID=

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=superior-ai
OTEL_LOG_SPANS=0
AUDIT_LOG_STDOUT=0

# Agent packs
PACK_SIGNING_SECRET=
PACK_SIGNING_PUBLIC_KEY=
PACK_PRICE_JSON=
PACK_PRICE_CREATIVE_STUDIO=
PACK_PRICE_FINANCE_OPS=
PACK_PRICE_SUPPORT_SUCCESS=

# Repo sandbox
REPO_SANDBOX_ROOT=
ALLOW_REPO_CLONE=0

# Code execution sandbox
ALLOW_CODE_EXEC=0
CODE_SANDBOX_ROOT=
PYTHON_PATH=python3

# ── Multi-engine search ──────────────────────────────────────────
# Global
SERPER_API_KEY=
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=
BING_SEARCH_API_KEY=
# Privacy / alt
BRAVE_SEARCH_API_KEY=
MOJEEK_API_KEY=
TAVILY_API_KEY=
STARTPAGE_API_KEY=
# Regional
YANDEX_SEARCH_API_KEY=
YANDEX_FOLDER_ID=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
BAIDU_SEARCH_API_KEY=
# Computational
WOLFRAM_APP_ID=
# DuckDuckGo needs no key (IA + HTML fallback always available)
