# SUPERIOR AI — Environment Configuration
# Copy to .env and fill in values. Never commit real secrets.

NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
API_URL=http://localhost:4000
APP_NAME=SUPERIOR AI

DATABASE_URL=postgresql://superior:superior@localhost:5432/superior_ai?schema=public
REDIS_URL=redis://localhost:6379

NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-to-a-long-random-secret-in-production

S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=superior-ai-artifacts
S3_REGION=us-east-1

OPENAI_API_KEY=
OPENAI_ORG_ID=
OPENAI_BASE_URL=https://api.openai.com/v1

ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com

XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1

GOOGLE_AI_API_KEY=
GOOGLE_AI_BASE_URL=https://generativelanguage.googleapis.com

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

LOCAL_INFERENCE_URL=http://localhost:11434/v1
LOCAL_INFERENCE_API_KEY=

ENABLE_LOCAL_FALLBACK=true
ENABLE_MULTI_KEY_POOL=true
ENABLE_COST_TRACKING=true
DEFAULT_INTELLIGENCE_LEVEL=BALANCED

ENCRYPTION_KEY=change-me-32-byte-hex-or-base64-key-for-secrets
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

LOG_LEVEL=info
